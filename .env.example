# Dia chi cong khai cua website. Production phai dung HTTPS.
APP_PUBLIC_URL=http://127.0.0.1:18765
# Production: đổi APP_PUBLIC_URL sang HTTPS thật và bật cưỡng chế HTTPS.
FORCE_HTTPS=false

# PayPal: dung sandbox de thu nghiem, live de nhan thanh toan that.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Ty gia ke toan do cua hang cau hinh; PayPal khong ho tro thanh toan truc tiep bang VND.
PAYPAL_VND_PER_USD=26085.01

# Khoa noi bo dung de bam du lieu gioi han dang nhap; tao chuoi ngau nhien dai khi deploy.
APP_SECURITY_KEY=

# SMTP Gmail (dung App Password, khong dung mat khau Google thong thuong).
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Lien Hoa Shop"
# Database: do not commit .env. MAMP is only an example; use your own values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_UNIX_SOCKET=
DB_NAME=paceup_db
DB_USER=
DB_PASSWORD=
