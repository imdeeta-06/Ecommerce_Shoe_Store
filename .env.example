# local | production
APP_ENV=local
# Dia chi cong khai cua website. MAMP mac dinh chay web tai cong 8888.
APP_PUBLIC_URL=http://127.0.0.1:8888
# Production: đổi APP_PUBLIC_URL sang HTTPS thật và bật cưỡng chế HTTPS.
FORCE_HTTPS=false

# PayPal: dung sandbox de thu nghiem, live de nhan thanh toan that.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Chỉ đặt true sau khi đã thu hồi khóa cũ và tạo bộ Live mới.
PAYPAL_LIVE_CREDENTIALS_ROTATED=false
# Ty gia ke toan do cua hang cau hinh; PayPal khong ho tro thanh toan truc tiep bang VND.
PAYPAL_VND_PER_USD=26085.01

# Khoa noi bo dung de bam du lieu gioi han dang nhap; tao chuoi ngau nhien dai khi deploy.
APP_SECURITY_KEY=

# SMTP Gmail (dung App Password, khong dung mat khau Google thong thuong).
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Lien Hoa Shop"
# Production chỉ bật SMTP sau khi đã đổi App Password từng bị lộ.
SMTP_CREDENTIALS_ROTATED=false
# Database: do not commit .env. MAMP is only an example; use your own values.
DB_HOST=127.0.0.1
DB_PORT=8889
DB_UNIX_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
DB_NAME=paceup_db
DB_USER=root
DB_PASSWORD=root
