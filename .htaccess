Options -Indexes
RewriteEngine On

# Không cho web server phục vụ mã nguồn, cấu hình, SQL, script bảo trì
# hoặc các view PHP nội bộ khi document root trỏ vào thư mục dự án.
RewriteRule ^(?:app|config|Database|scripts|tests|\.git|\.vs)(?:/|$) - [F,L,NC]
RewriteRule ^public/views(?:/|$) - [F,L,NC]
RewriteRule ^public/assets/index\.php$ - [F,L,NC]
# Chỉ front controller index.php được gọi trực tiếp ở thư mục gốc.
RewriteRule ^(?!index\.php$)[^/]+\.php$ - [F,L,NC]
RewriteRule ^(?:README\.md|patch\.js|\.env(?:\..*)?)$ - [F,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
